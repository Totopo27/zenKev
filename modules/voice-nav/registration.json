/**
 * @file registration.json
 * Definición del actor JSWindowActor para ser registrado en Zen Browser
 * (ej. en ZenActorsManager.sys.mjs o vía ChromeUtils.registerWindowActor).
 */

{
  "ZenVoiceNav": {
    "parent": {
      "esModuleURI": "resource:///actors/ZenVoiceNavParent.sys.mjs"
    },
    "child": {
      "esModuleURI": "resource:///actors/ZenVoiceNavChild.sys.mjs",
      "events": {}
    },
    "allFrames": false,
    "messageManagerGroups": ["browsers"],
    "remoteTypes": ["web", "file", "privilegedabout"],
    "safeForUntrustedWebProcess": true,
    "enablePreference": "zen.voicenav.enabled"
  }
}
